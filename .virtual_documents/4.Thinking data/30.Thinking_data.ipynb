import json 


# Load the data 

def load_data(filename):
    with open (filename,"r") as f:
        data = json.load(f)

    return data
        



data = load_data('store_data.json')

print(data)
print(type(data))





# cleaning and stracturing our data


# clean & stracture the data 
def clean_data(data):

    text_to_numbers ={ "one":1 , "two":2 , "three":3 , "four":4 , "five":5}
    
    for user in data:
        # clean the rating part 
        raw_rating =user['rating'].strip().lower()  # strip()  =  "  5  "  => "5"
        
        if(raw_rating in text_to_numbers):
            raw_rating = text_to_numbers[raw_rating]

        user['rating'] = raw_rating
            
    


clean_data(data)


