# break statment 

i = 1

while (i<= 10 ):
    if (i%6 == 0):
        break


    print(i)
    i=i+1
print("outside the loop now ..")


# continoue statment 

i = 1
while (i <=10):
    if (i%3==0):
        i=i+1
        continue
    print(i)
    i=i+1

 


# print all the odd number between 1 to 10 

i = 0

while (i<10):
    i = i+1
    if (i%2==0):
        continue
    print(i)




